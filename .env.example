# Vespera Bot Environment Variables Example

DISCORD_TOKEN=your_discord_bot_token_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Comma-separated list of fallback models
FALLBACK_MODELS=models/gemma-3-27b-it,models/gemini-2.0-flash-lite

# Enable Chain-of-Thought for lyrical translations (default: true)
# Set to "false" to save tokens and reduce latency (disables scratchpad)
LYRICAL_COT_ENABLED=true

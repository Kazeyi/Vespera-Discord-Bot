class ActionInputModal(discord.ui.Modal, title="Describe Your Action"):
    """Modal for entering custom action with target context"""
    
    def __init__(self, bot_cog, original_interaction, target_name: str):
        super().__init__()
        self.bot_cog = bot_cog
        self.original_interaction = original_interaction

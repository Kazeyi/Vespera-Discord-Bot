class ActionEconomyValidator:
    """
    Validate and limit player actions to D&D 5e/2024 rules.
    
    Players have per turn:
    - 1 Action (cast spell, attack, dodge, disengage, etc.)
    - 1 Bonus Action (some abilities, spells marked as bonus action)
    - 1 Reaction (until next turn, triggered by external event)
    - Movement (up to speed)
    
    This validator detects when players try to exceed these limits
    and enforces them in the truth block for the AI.
    
    NOTE: Action keywords can be auto-updated from dnd_rulebook table
    using refresh_from_database() method for [Action] tagged rules.
    """
    
    # Keywords indicating each action type (refreshable from DB)
    ACTION_KEYWORDS = {
        "action": [
            "attack", "cast", "dodge", "disengage", "dash", "ready",
            "hide", "search", "use", "drink", "disarm", "help", "push",
            "shove", "grapple", "sheathe", "draw", "reload"
        ],
        "bonus_action": [
            "bonus", "quick cast", "quicken", "action surge", "flurry",
            "cunning action", "second wind", "hunter's mark", "bonus spell",
            "offhand attack", "off-hand", "dual wield", "bonus attack"
        ],
        "reaction": [
            "reaction", "counter", "counterspell", "shield", "opportunity",
            "opportunity attack", "reaction attack", "riposte", "parry",
            "readied action"
        ],
        "movement": [
            "move", "walk", "run", "fly", "swim", "step",
            "dash", "jump", "teleport", "stride"
        ]
    }
    
    # Cache timestamp for DB refresh
    _last_db_refresh = None
    _refresh_interval = 3600  # Refresh every hour
    
    MULTIPLE_ACTION_INDICATORS = [
        " and ",
        " then ",
        " after that ",
        " next ",
        " before ",
        " while ",
        " also ",
        " plus ",
        ", then",
        ". then",
    ]
    
    # Roleplay phrases that should NOT trigger action economy (movement + observation)
    ROLEPLAY_EXCEPTIONS = [
        "look at",
        "walk over and look",
        "move to",
        "walk to",
        "run to",
        "approach and examine",
        "move closer and inspect",
        "step toward",
        "go to",
        "head to",
        "walk around",
        "move and see",
        "walk and observe",
        "go and check"
    ]
    
    @staticmethod
    def refresh_from_database():
        """Refresh ACTION_KEYWORDS from dnd_rulebook table [Action] tags (1 hour cache)"""
        import time
        
        # Check if refresh needed
        now = time.time()
        if ActionEconomyValidator._last_db_refresh is not None:
            if now - ActionEconomyValidator._last_db_refresh < ActionEconomyValidator._refresh_interval:
                return  # Cache still valid
        
        try:
            # Get all [Action] tagged keywords from rulebook
            action_keywords = RulebookIngestor.get_action_keywords()
            
            if action_keywords:
                # Merge with existing keywords (no duplicates)
                current_actions = set(ActionEconomyValidator.ACTION_KEYWORDS["action"])
                new_actions = set(action_keywords)
                merged = current_actions.union(new_actions)
                
                ActionEconomyValidator.ACTION_KEYWORDS["action"] = list(merged)
                ActionEconomyValidator._last_db_refresh = now
                
                print(f"[ActionEconomyValidator] Refreshed {len(new_actions)} action keywords from database")
        
        except Exception as e:
            print(f"[ActionEconomyValidator] DB refresh failed: {e}")
    
    @staticmethod
    def validate_action_economy(action: str, character_data: dict = None) -> dict:
        """
        Validate action economy and return analysis.
        
        Auto-refreshes action keywords from dnd_rulebook table (hourly cache).
        
        Returns:
            {
                'action_count': int,           # Number of actions attempted
                'is_valid': bool,              # Within economy limits
                'actions_used': {
                    'action': int,
                    'bonus_action': int,
                    'reaction': int
                },
                'excess_actions': [str],      # Actions that overflow
                'warning': str,               # Warning message for AI
                'enforcement_instruction': str # Instruction for AI to follow
            }
        """
        # Refresh action keywords from database (cached hourly)
        ActionEconomyValidator.refresh_from_database()
        
        action_lower = action.lower()
        
        # Check if this is just roleplay/movement (exception handling)
        is_roleplay_only = any(exception in action_lower for exception in ActionEconomyValidator.ROLEPLAY_EXCEPTIONS)
        
        # Get character's extra attack capability (Fighters, Monks, etc.)
        extra_attacks = 1  # Default: 1 attack per Attack action
        if character_data:
            char_level = character_data.get('level', 1)
            char_class = character_data.get('class', '').lower()
            
            # Fighters, Paladins, Rangers, Barbarians get Extra Attack
            if char_class in ['fighter', 'paladin', 'ranger', 'barbarian', 'monk']:
                if char_level >= 5:
                    extra_attacks = 2
                if char_class == 'fighter' and char_level >= 11:
                    extra_attacks = 3
                if char_class == 'fighter' and char_level >= 20:
                    extra_attacks = 4
            
            # Check for Haste spell effect
            conditions = character_data.get('conditions', '')
            if 'haste' in conditions.lower():
                extra_attacks += 1  # Haste grants one additional attack
        
        # Count each type of action attempted (only count explicit mechanical actions)
        action_count = 0
        bonus_action_count = 0
        reaction_count = 0
        movement_mentioned = False
        attack_instances = 0  # Track number of attack keywords found
        
        # Count actions (explicit action keywords)
        for keyword in ActionEconomyValidator.ACTION_KEYWORDS['action']:
            if keyword in action_lower:
                # Special handling for attack keywords
                if keyword in ['attack', 'strike', 'hit', 'slash', 'shoot']:
                    attack_instances += 1
                else:
                    action_count += 1
        
        # Adjust action count based on Extra Attack feature
        # If player says "I attack three times" and they have Extra Attack (3), that's valid
        if attack_instances > 0:
            if attack_instances <= extra_attacks:
                # Valid use of Extra Attack - counts as 1 action
                action_count += 1
            else:
                # Trying to attack more times than Extra Attack allows
                action_count += attack_instances  # Will trigger overflow
        
        # Count bonus actions
        for keyword in ActionEconomyValidator.ACTION_KEYWORDS['bonus_action']:
            if keyword in action_lower:
                bonus_action_count += 1
        
        # Count reactions
        for keyword in ActionEconomyValidator.ACTION_KEYWORDS['reaction']:
            if keyword in action_lower:
                reaction_count += 1
        
        # Check for movement (doesn't count against action economy if done with other action)
        for keyword in ActionEconomyValidator.ACTION_KEYWORDS['movement']:
            if keyword in action_lower:
                movement_mentioned = True
                break
        
        # Skip connector checking if this is clearly roleplay
        if is_roleplay_only:
            # This is just movement + observation, not multiple actions
            multiple_actions_connectors = 0
        else:
            # Check for multiple action indicators (player doing multiple distinct things)
            multiple_actions_connectors = 0
            for indicator in ActionEconomyValidator.MULTIPLE_ACTION_INDICATORS:
                if indicator in action_lower:
                    multiple_actions_connectors += 1
            
            # Smart counting: if multiple connectors found, adjust action count
            # But be lenient: "move and attack" is allowed, "attack and attack" is not
            if multiple_actions_connectors > 0 and action_count <= 1 and bonus_action_count == 0 and reaction_count == 0:
                # Likely just movement + one action (allowed)
                pass
            elif multiple_actions_connectors > 0 and not movement_mentioned:
                # Multiple distinct action attempts detected (not just movement)
                action_count = max(action_count, multiple_actions_connectors + 1)
        
        # Determine if valid and what's exceeded
        is_valid = True
        excess_actions = []
        warning = ""
        enforcement_instruction = ""
        
        # Check action limits
        if action_count > 1:
            is_valid = False
            excess_actions.append(f"Multiple Actions ({action_count} attempted, max 1)")
            
            # Provide helpful feedback about Extra Attack
            if attack_instances > extra_attacks:
                warning = f"⚠️ OVERFLOW: Player attempted {attack_instances} attacks but Extra Attack allows {extra_attacks} per turn."
                enforcement_instruction = (
                    f"The player can make up to {extra_attacks} attacks with their Attack action. "
                    f"They attempted {attack_instances}. Allow the first {extra_attacks} attacks, then explain: "
                    f"'Your Extra Attack feature allows {extra_attacks} attacks per turn. You cannot attack again.'"
                )
            else:
                warning = f"⚠️ OVERFLOW: Player attempted {action_count} actions but only has 1 per turn."
                enforcement_instruction = (
                    "The player tries to perform multiple actions but only completes the FIRST one. "
                    "Narrate the first action's result, then explain: "
                    "'You've already used your action for this turn. You cannot do that now.'"
                )
        
        if bonus_action_count > 1:
            is_valid = False
            excess_actions.append(f"Multiple Bonus Actions ({bonus_action_count} attempted, max 1)")
            if not warning:
                warning = f"⚠️ OVERFLOW: Player attempted {bonus_action_count} bonus actions but only has 1 per turn."
            if not enforcement_instruction:
                enforcement_instruction = (
                    "The player tries to use multiple bonus actions but only completes the FIRST one. "
                    "Narrate the result and explain they've used their bonus action for this turn."
                )
        
        if reaction_count > 1:
            is_valid = False
            excess_actions.append(f"Multiple Reactions ({reaction_count} attempted, max 1)")
            if not warning:
                warning = f"⚠️ OVERFLOW: Player attempted {reaction_count} reactions but only has 1 per turn."
            if not enforcement_instruction:
                enforcement_instruction = (
                    "Explain that the player only has one reaction per round and must choose which one to use."
                )
        
        # Combine action and bonus action excess
        total_core_actions = action_count + bonus_action_count
        if total_core_actions > 2:  # More than 1 action + 1 bonus action
            if "first" not in enforcement_instruction.lower():
                is_valid = False
                enforcement_instruction = (
                    f"The player attempted too much. Only the FIRST major action succeeds. "
                    f"They've used their action economy for this turn."
                )
        
        # If no legitimate actions detected but player still acted (likely roleplay)
        if action_count == 0 and bonus_action_count == 0 and reaction_count == 0 and len(action) > 20:
            # This is general roleplay/movement/investigation
            enforcement_instruction = (
                "This is general roleplay, movement, or exploration. Resolve it naturally within turn rules."
            )
        
        return {
            'action_count': action_count,
            'bonus_action_count': bonus_action_count,
            'reaction_count': reaction_count,
            'is_valid': is_valid,
            'actions_used': {
                'action': action_count,
                'bonus_action': bonus_action_count,
                'reaction': reaction_count
            },
            'excess_actions': excess_actions,
            'warning': warning,
            'enforcement_instruction': enforcement_instruction,
            'total_actions_attempted': action_count + bonus_action_count + reaction_count
        }



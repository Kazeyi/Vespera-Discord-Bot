    """Optimized name generator"""
    
    SIMPLE_THEMES = {
        "ocean": ["Aqua", "Mar", "Tidal", "Coral", "Wave", "Deep", "Salt"],
        "volcano": ["Ignis", "Pyro", "Magma", "Ash", "Flame", "Ember"],

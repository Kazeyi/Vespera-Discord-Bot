# --- RULEBOOK RAG SYSTEM ---
class RulebookIngestor:
    """Memory-efficient rulebook importer for markdown files (optimized for 1 core/1GB RAM)"""
    
    # Pre-compiled regex patterns for performance
    HEADER_PATTERN = re.compile(r'^####\s+(.+?)(?:\s+\[(.+?)\])?\s*$')
    SEE_ALSO_PATTERN = re.compile(r'\*See also\*\s+[""](.+?)[""]', re.IGNORECASE)
    BATCH_SIZE = 50  # Balance memory vs DB operations
    
    @staticmethod
    def ingest_markdown_rulebook(file_path: str, source: str = "SRD 2024") -> Dict[str, int]:
        """Stream-parse markdown file and populate dnd_rulebook table
        
        Args:
            file_path: Path to .md file (e.g., 'srd/RulesGlossary.md')
            source: Source attribution for rules
        
        Returns:
            Dict with stats: {'inserted': N, 'updated': N, 'skipped': N}
        """
        if not os.path.exists(file_path):
            raise FileNotFoundError(f"Rulebook not found: {file_path}")
        
        stats = {'inserted': 0, 'updated': 0, 'skipped': 0}
        batch = []
        
        current_keyword = None
        current_rule_type = None
        current_text_lines = []
        
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.rstrip()
                    
                    # Check for new header
                    match = RulebookIngestor.HEADER_PATTERN.match(line)
                    if match:
                        # Save previous entry
                        if current_keyword and current_text_lines:
                            entry = RulebookIngestor._create_entry(
                                current_keyword, current_rule_type, 
                                current_text_lines, source
                            )
                            batch.append(entry)
                            
                            # Batch insert when threshold reached
                            if len(batch) >= RulebookIngestor.BATCH_SIZE:
                                RulebookIngestor._batch_insert(c, batch, stats)
                                batch = []
                        
                        # Start new entry
                        current_keyword = match.group(1).strip()
                        current_rule_type = match.group(2).strip() if match.group(2) else "general"
                        current_text_lines = []
                    
                    elif current_keyword:
                        # Skip empty lines at start of entry
                        if not current_text_lines and not line.strip():
                            continue
                        # Stop at next major header
                        if line.startswith('## ') or line.startswith('# '):
                            # Save and reset
                            if current_text_lines:
                                entry = RulebookIngestor._create_entry(
                                    current_keyword, current_rule_type,
                                    current_text_lines, source
                                )
                                batch.append(entry)
                            current_keyword = None
                            current_text_lines = []
                        else:
                            current_text_lines.append(line)
                
                # Handle last entry
                if current_keyword and current_text_lines:
                    entry = RulebookIngestor._create_entry(
                        current_keyword, current_rule_type,
                        current_text_lines, source
                    )
                    batch.append(entry)
                
                # Insert remaining batch
                if batch:
                    RulebookIngestor._batch_insert(c, batch, stats)
            
            conn.commit()
            
            # Clear cache since new rules added
            RulebookRAG.RULE_CACHE.clear()
            
        finally:
            conn.close()
        
        return stats
    
    @staticmethod
    def _create_entry(keyword: str, rule_type: str, text_lines: List[str], source: str) -> Tuple[str, str, str, str]:
        """Create DB entry tuple from parsed markdown"""
        # Join text and clean up
        rule_text = '\n'.join(text_lines).strip()
        
        # Normalize rule_type
        rule_type_normalized = rule_type.lower() if rule_type != "general" else "general"
        
        # Keyword lowercase for consistency
        keyword_normalized = keyword.lower()
        
        return (keyword_normalized, rule_text, rule_type_normalized, source)
    
    @staticmethod
    def _batch_insert(cursor, batch: List[Tuple], stats: Dict[str, int]):
        """Efficiently insert batch of rules with conflict handling"""
        try:
            cursor.executemany(
                "INSERT OR REPLACE INTO dnd_rulebook (keyword, rule_text, rule_type, source) VALUES (?, ?, ?, ?)",
                batch
            )
            stats['inserted'] += len(batch)
        except sqlite3.Error as e:
            print(f"[RulebookIngestor] Batch insert error: {e}")
            # Fallback to individual inserts
            for entry in batch:
                try:
                    cursor.execute(
                        "INSERT OR REPLACE INTO dnd_rulebook (keyword, rule_text, rule_type, source) VALUES (?, ?, ?, ?)",
                        entry
                    )
                    stats['inserted'] += 1
                except sqlite3.Error:
                    stats['skipped'] += 1
    
    @staticmethod
    def extract_see_also_references(keyword: str) -> List[str]:
        """Extract 'See also' references from a rule's text"""
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        
        c.execute("SELECT rule_text FROM dnd_rulebook WHERE keyword = ?", (keyword.lower(),))
        result = c.fetchone()
        conn.close()
        
        if not result:
            return []
        
        rule_text = result[0]
        matches = RulebookIngestor.SEE_ALSO_PATTERN.findall(rule_text)
        
        # Extract individual references
        references = []
        for match in matches:
            # Split on common separators
            parts = re.split(r',|and|;', match)
            for part in parts:
                # Clean quotes and whitespace
                ref = part.strip().strip('"').strip("'").strip()
                if ref:
                    references.append(ref.lower())
        
        return references
    
    @staticmethod
    def get_action_keywords() -> List[str]:
        """Get all keywords tagged as [Action] for ActionEconomyValidator auto-update"""
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        
        c.execute("SELECT keyword FROM dnd_rulebook WHERE rule_type = 'action'")
        actions = [row[0] for row in c.fetchall()]
        
        conn.close()
        return actions


class RulebookRAG:
    """Efficient Rulebook Retrieval for 1GB RAM"""
    
    RULE_CACHE = {}
    CACHE_MAX_SIZE = 50
    
    @staticmethod
    def init_rulebook_table():
        """Initialize rulebook table in database"""
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        
        c.execute('''CREATE TABLE IF NOT EXISTS dnd_rulebook (
            keyword TEXT PRIMARY KEY,
            rule_text TEXT,
            rule_type TEXT,
            source TEXT
        )''')
        
        c.execute('''CREATE INDEX IF NOT EXISTS idx_rulebook_keyword 
                    ON dnd_rulebook(keyword)''')
        
        c.execute("SELECT COUNT(*) FROM dnd_rulebook")
        if c.fetchone()[0] == 0:
            # 2024 rules only
            core_rules = [
                ("fireball", "3rd-level evocation. Casting Time: 1 action. Range: 150 feet. Components: V, S, M. Duration: Instantaneous. Each creature in a 20-foot-radius sphere must make a Dexterity saving throw. A target takes 8d6 fire damage on a failed save, or half as much on a success.", "spell", "PHB 2024"),
